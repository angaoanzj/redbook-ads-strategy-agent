# 复制为 .env 或 course.env 后填入真实 Key（二者任选其一；已 export 的环境变量优先）
# cp .env.example .env

# Analyzer：六模块 Agent / 报告润色（可指向 DeepSeek 或硅基流动）
AGENT_ANALYZER_API_KEY=
AGENT_ANALYZER_BASE_URL=https://api.deepseek.com
AGENT_ANALYZER_MODEL=deepseek-v4-flash

# Embedding：向量检索（可选；当前知识库默认仍走 SQLite FTS）
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
AGENT_EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B

# 兼容旧变量（未设 ANALYZER_* 时回退）
AGENT_OPENAI_API_KEY=
AGENT_OPENAI_BASE_URL=https://api.siliconflow.cn/v1
AGENT_OPENAI_MODEL=Qwen/Qwen3-8B

# Critic 二审（可选；默认关闭）
AGENT_CRITIC_ENABLED=0
AGENT_CRITIC_MODEL=

# 竞品快照 TTL（天，默认 14）
# XHS_COMPETITOR_CACHE_TTL_DAYS=14
